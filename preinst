#!/bin/sh
HW_MODEL=$(sysctl -n hw.machine 2>/dev/null)
if [ "$HW_MODEL" != "iPhone14,4" ]; then
    echo "==========================================================" >&2
    echo "❌ LỖI BẢN QUYỀN THIẾT BỊ:" >&2
    echo "Gói cài đặt này chỉ dành riêng cho iPhone 13 mini (iPhone14,4)!" >&2
    echo "Thiết bị hiện tại: $HW_MODEL" >&2
    echo "Tiến trình cài đặt bị hủy bỏ!" >&2
    echo "==========================================================" >&2
    exit 1
fi
exit 0
